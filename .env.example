# .env.example — Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# Gerçek .env dosyası git'e commit edilmez.

# SHA-256 hash'lerini üretmek için:
#   node -e "const c=require('crypto'); console.log(c.createHash('sha256').update('YENİDEĞER').digest('hex'));"

# Admin panel giriş (frontend)
VITE_ADMIN_USER_HASH=<kullanici_adinin_sha256_hashi>
VITE_ADMIN_PASS_HASH=<sifrenin_sha256_hashi>

# API endpoint auth (backend - aynı şifre hash'i)
ADMIN_PASS_HASH=<sifrenin_sha256_hashi_ile_ayni>

# NOT: ADMIN_PASS_HASH ve VITE_ADMIN_PASS_HASH aynı değer olmalı.
# VITE_ öneki olan frontend'de (tarayıcı) kullanılır,
# VITE_ öneki olmayan backend'de (Nitro server) kullanılır.

# PostgreSQL — yalnızca sunucuda kullanılır. VITE_ öneki eklemeyin.
DATABASE_URL=postgresql://postgres:PAROLA@localhost:5432/minatoi

# PayTR — yalnızca sunucu; VITE_ öneki eklemeyin.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_ENABLED=0
PAYTR_TEST_MODE=0
# Yeni uygulamanın yayın adresi; PayTR panel ayarını değiştirmez.
PAYTR_PUBLIC_URL=https://minatoi.dijitalpanter.com
# Yalnızca yerel geliştirmede, internet bağlantınızın dış IP adresi.
PAYTR_LOCAL_IP=
# Ubuntu: Nginx x-real-ip başlığını yeniden yazmalı; uygulama portu dışarı kapalı olmalı.
PAYTR_TRUST_PROXY=0

# Havale/EFT — üç bilgi geçerliyse seçenekte gösterilir.
BANK_TRANSFER_ENABLED=0
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_HOLDER=
BANK_TRANSFER_IBAN=
