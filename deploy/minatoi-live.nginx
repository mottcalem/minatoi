server {
    server_name minatoi.com www.minatoi.com;
    root /var/www/minatoi/current/.output/public;
    client_max_body_size 50m;
    charset utf-8;

    location ^~ /products/ {
        alias /var/www/minatoi/current/public/products/;
    }
    location ^~ /assets/ {
        alias /var/www/minatoi/current/.output/public/assets/;
        try_files $uri =404;
        expires 1y;
    }
    location ^~ /images/uploads/ {
        alias /var/www/minatoi/current/public/images/uploads/;
        try_files $uri =404;
    }
    location /images/ {
        root /var/www/minatoi/current/public;
        try_files $uri @minatoi;
    }
    location / { try_files $uri @minatoi; }
    location @minatoi {
        proxy_pass http://127.0.0.1:3006;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/minatoi.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/minatoi.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.minatoi.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = minatoi.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name minatoi.com www.minatoi.com;
    return 404; # managed by Certbot




}